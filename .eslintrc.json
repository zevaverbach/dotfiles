{
    "extends": "standard-with-typescript",
    "overrideConfig": {
        "env": {
            "browser": true,
            "es2021": true,
            "node": true
        },
        "rules": {
            "indent": ["error", 4],
            "semi": ["error", "always"],
            "quotes": ["error", "double"],
            "comma-dangle": ["error", "only-multiline"],
            "space-before-function-paren": ["error", "never"],
            "newline-per-chained-call": ["error", { "ignoreChainWithDepth": 2 }]
        },
        "parserOptions": {
            "ecmaVersion": "latest",
            "sourceType": "module"
        }
    }
}
