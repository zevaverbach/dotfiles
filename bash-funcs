tok() {
  if [ $# -eq 0 ]; then
      echo "provide a file"
      return 1
  elif [ -f "$1" ]; then
      # First argument is a file
      ttok -i "$1"
  else
      # Treat as text string
      echo "$*" | ttok
  fi
}

steel-clear-locks() {
    local root="${STEEL_LOCK_ROOT:-/tmp/steel-browser-locks}"
    local force=0
    if [ "${1:-}" = "--force" ]; then
        force=1
    fi
    if [ ! -d "$root" ]; then
        echo "steel locks: none (${root} missing)"
        return 0
    fi
    local removed=0
    local kept=0
    for d in "$root"/*; do
        [ -d "$d" ] || continue
        if [ "$force" -eq 0 ] && [ -f "$d/pid" ]; then
            local pid
            pid=$(cat "$d/pid" 2>/dev/null || true)
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                kept=$((kept + 1))
                continue
            fi
        fi
        rm -rf "$d"
        removed=$((removed + 1))
    done
    echo "steel locks cleared: removed=${removed} kept=${kept} root=${root}"
}

