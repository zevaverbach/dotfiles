bws-get() {
  if [ -z "$1" ]; then
    echo "Usage: bws-get <KEY_NAME>"
    return 1
  fi
  bws secret list | jq -r --arg k "$1" '.[] | select(.key==$k) | .value'
}

bws-set() {
  if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Usage: bws-set <KEY_NAME> <NEW_VALUE>"
    return 1
  fi
  local key="$1"
  local value="$2"
  local id
  id=$(bws secret list | jq -r --arg k "$key" '.[] | select(.key==$k) | .id')

  if [ -z "$id" ]; then
    echo "Secret '$key' not found"
    return 1
  fi

  bws secret edit "$id" --value "$value"
  echo "Updated '$key'"
}

bws-list() {
  bws secret list | jq -r '.[] | "\(.key)\t\(.id)"' | column -t
}

