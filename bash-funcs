gc() {
    if [ -z "$1" ]; then
        # No message provided, explicitly use the editor
        # The -e flag forces Git to open the editor regardless of configuration
        git commit --edit --allow-empty-message
    else
        # Message provided, use it directly
        git commit -m "$1"
    fi
}

gl() {
    local format="%C(yellow)%h%C(reset) %C(blue)%ad%C(reset) %s%C(red)%d%C(reset)"
    # If two arguments are provided, assume they're commit hashes
    if [ $# -eq 2 ] && [[ $1 != -* ]] && [[ $2 != -* ]]; then
        # Show logs between the two hashes with nice formatting
        git log $1..$2 --pretty=format:"$format" --date=short
    else
        # Otherwise, just run git log with whatever arguments were passed
        git log "$@"
    fi
}

