bx_scp() {
    if [ "$#" -lt 2 ]; then
        echo "usage: bx-scp <src> <dest>"
        return 1
    fi

    local args=("$@")
    local last_index=$(( $# - 1 ))
    local host="zev@box.averba.ch"

    if [[ "${args[0]}" == *:* || "${args[$last_index]}" == *:* ]]; then
        scp "${args[@]}"
        return
    fi

    if [[ "${args[0]}" == :* ]]; then
        args[0]="${host}${args[0]}"
    elif [[ "${args[$last_index]}" == :* ]]; then
        args[$last_index]="${host}${args[$last_index]}"
    else
        # Default: assume dest is remote path
        args[$last_index]="${host}:${args[$last_index]}"
    fi

    scp "${args[@]}"
}

